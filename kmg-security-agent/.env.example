# Модель: только Qwen или DeepSeek (требование организатора).
# Подключение через OpenAI-совместимый API (/chat/completions).

# Вариант 1 — Qwen через OpenRouter (по умолчанию)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace_with_your_key
LLM_MODEL=qwen/qwen3.8-27b:free

# Вариант 2 — DeepSeek (официальный API)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace_with_your_key
# LLM_MODEL=deepseek-chat

# Вариант 3 — модель, развёрнутая организатором: адрес, ключ и имя модели от организатора

# Только для OpenRouter: разрешить платные модели
ALLOW_PAID_MODEL=false
